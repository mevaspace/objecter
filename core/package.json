{
  "name": "@mevaspace/objecter-core",
  "scripts": {
    "lintstaged:lint": "oxlint --fix",
    "lint": "oxlint --fix",
    "prebuild": "rimraf ../dist",
    "build": "tsup src/index.ts --format cjs,esm --dts --minify --clean",
    "postbuild": "ts-node ../scripts/copy-package.ts",
    "test:unit": "jest -c test/jest.unit.config.json",
    "test:cov": "jest -c test/jest.unit.config.json --coverage",
    "test:e2e": "jest -c test/jest.e2e.config.json"
  },
  "devDependencies": {
    "@swc/core": "^1.15.40",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "catalog:",
    "jest": "^30.2.0",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "rimraf": "^6.1.2",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typescript": "catalog:"
  }
}
