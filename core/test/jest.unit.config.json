{
  "preset": "ts-jest",
  "rootDir": "..",
  "testEnvironment": "node",
  "roots": ["<rootDir>/test/unit"],
  "testMatch": ["**/*.spec.ts"],
  "collectCoverageFrom": ["src/**/*.ts", "!src/**/*.spec.ts", "!src/**/index.ts", "!src/types/**/*.ts"],
  "coverageThreshold": { "global": { "branches": 80, "functions": 80, "lines": 80, "statements": 80 } }
}
