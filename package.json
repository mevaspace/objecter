{
  "name": "@mevaspace/objecter",
  "author": "Ivan Azis <ivanazis.id@gmail.com>",
  "license": "MIT",
  "version": "1.2.0",
  "description": "A simple object manipulation library",
  "packageManager": "pnpm@11.5.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/mevaspace/objecter.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/",
    "access": "public"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "format": "prettier --write --config .prettierrc.json .",
    "precz": "pnpm prepare",
    "preinstall": "pnpm dlx only-allow pnpm",
    "pretest:benchmark": "pnpm build && pnpm --filter @mevaspace/objecter-benchmark install",
    "test:benchmark": "pnpm --filter @mevaspace/objecter-benchmark test",
    "test:unit": "pnpm --filter @mevaspace/objecter-core test:unit",
    "test:cov": "pnpm --filter @mevaspace/objecter-core test:cov",
    "test:e2e": "pnpm --filter @mevaspace/objecter-core test:e2e",
    "build": "pnpm --filter @mevaspace/objecter-core build",
    "release": "semantic-release",
    "release:dry": "semantic-release --dry-run",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/npm": "^13.1.4",
    "@types/node": "catalog:",
    "commitizen": "^4.3.1",
    "commitlint": "^20.4.1",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "oxlint-tsgolint": "catalog:",
    "prettier": "^3.8.1",
    "semantic-release": "^25.0.3"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
